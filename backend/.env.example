# Use a dedicated MariaDB database and account. Never put real credentials here.
PAYMENTS_DATABASE_URL=mysql://seeyourseo_payments:CHANGE_ME@127.0.0.1:3306/seeyourseo_payments

# PayPal REST app credentials. Keep PAYPAL_CLIENT_SECRET server-side.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_SANDBOX_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=YOUR_SANDBOX_WEBHOOK_ID

PUBLIC_BASE_URL=https://seeyourseo.com
VISITOR_LOG_PATH=data/visitor-access.jsonl
